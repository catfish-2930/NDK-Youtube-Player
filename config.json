{
  "toolChecks": [
    {
      "key": "ytdlp",
      "label": "yt-dlp version",
      "statusChannel": "plugin:youtube-player:getYtdlpVersion",
      "channel": "plugin:youtube-player:checkYtdlpUpdate"
    }
  ],
  "settings": [
    {
      "key": "recommendationQuery",
      "label": "Recommendation query",
      "type": "text",
      "default": "华语 KTV 官方 MV"
    },
    {
      "key": "playerClient",
      "label": "YouTube player client",
      "type": "select",
      "default": "android_vr",
      "options": [
        {
          "label": "android_vr (faster, no n challenge)",
          "value": "android_vr"
        },
        {
          "label": "web_embedded (n challenge, PO token)",
          "value": "web_embedded"
        }
      ]
    },
    {
      "key": "maxVideoHeight",
      "label": "Max video quality",
      "type": "select",
      "default": 1080,
      "options": [
        {
          "label": "480p",
          "value": 480
        },
        {
          "label": "720p",
          "value": 720
        },
        {
          "label": "1080p",
          "value": 1080
        },
        {
          "label": "2K",
          "value": 1440
        },
        {
          "label": "4K",
          "value": 2160
        }
      ]
    }
  ]
}
