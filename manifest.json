{
  "id": "youtube-player",
  "name": "NDK-YouTube Player",
  "version": "0.1.0",
  "description": "Online multimedia player",
  "type": "Multimedia",
  "github": "https://github.com/catfish-2930/NDK-Youtube-Player",
  "enabledByDefault": true,
  "installer": {
    "windows": {
      "workDir": "plugins/workspace/youtube-player",
      "toolsDir": "plugins/installed/youtube-player/vendor/bin",
      "tools": [
        {
          "id": "yt-dlp",
          "name": "yt-dlp",
          "url": "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp.exe",
          "target": "yt-dlp.exe"
        }
      ]
    },
    "linux": {
      "workDir": "plugins/workspace/youtube-player",
      "toolsDir": "plugins/installed/youtube-player/vendor/bin",
      "notes": [
        "yt-dlp will be installed into the plugin vendor/bin folder."
      ],
      "tools": [
        {
          "id": "yt-dlp",
          "name": "yt-dlp",
          "url": "https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux",
          "target": "yt-dlp"
        }
      ]
    }
  },
  "entryPoints": {
    "home": {
      "label": "YouTube",
      "route": "/plugins/youtube-player",
      "order": 100
    },
    "settings": {
      "route": "/settings/plugins/youtube-player"
    }
  },
  "renderer": {
    "source": "renderer/YouTubePluginPage.jsx",
    "entry": "renderer/index.js"
  },
  "main": {
    "entry": "main/index.mjs"
  }
}
